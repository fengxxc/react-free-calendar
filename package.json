{
    "name": "react-free-calendar",
    "version": "0.2.1",
    "description": "A react calendar component. basal, hight customization and no style.",
    "keywords": [
        "react",
        "react-dom",
        "calendar",
        "year",
        "month",
        "date",
        "day",
        "week",
        "component",
        "customization"
    ],
    "homepage": "https://github.com/fengxxc/react-free-calendar",
    "author": "fengxxc",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/fengxxc/react-free-calendar"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "type": "module",
    "main": "dist/index.cjs",
    "exports": {
        ".": {
            "import": "./src/index.ts"
        }
    },
    "publishConfig": {
        "main": "dist/index.cjs",
        "module": "dist/index.js",
        "types": "dist/index.d.ts",
        "exports": {
            ".": {
                "import": "./dist/index.js",
                "require": "./dist/index.cjs"
            }
        },
        "registry": "https://registry.npmjs.org/"
    },
    "typesVersions": {
        "*": {
            "*": [
                "./dist/*",
                "./dist/components/*",
                "./*"
            ]
        }
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "preview": "vite preview",
        "test": "echo \"No test specified\""
    },
    "dependencies": {
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-resize-detector": "^10.0.1"
    },
    "devDependencies": {
        "@types/node": "^20.12.7",
        "@types/react": "^18.2.66",
        "@types/react-dom": "^18.2.22",
        "@typescript-eslint/eslint-plugin": "^7.2.0",
        "@typescript-eslint/parser": "^7.2.0",
        "@vitejs/plugin-react": "^4.2.1",
        "eslint": "^8.57.0",
        "eslint-plugin-react-hooks": "^4.6.0",
        "eslint-plugin-react-refresh": "^0.4.6",
        "prettier": "^3.2.5",
        "rollup-plugin-preserve-directives": "^0.4.0",
        "typescript": "^5.2.2",
        "vite": "^5.2.0",
        "vite-plugin-dts": "^3.8.1"
    }
}
